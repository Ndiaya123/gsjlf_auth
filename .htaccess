
<IfModule mod_headers.c>
  <FilesMatch "\.(js)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>
# protéger le fichier db.php
<FilesMatch "\.(html|php)$">
  Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
</FilesMatch>

<files db.php>
order allow,deny
deny from all
</files>




#rediriger vers page de connexion
DirectoryIndex index.php

#protéger les dossiers
Options -Indexes

#page d'acceuil
RewriteEngine on
#RewriteRule ^acceuil$ index.php [L]

#redirection HTTP vers HTTPS
#RewriteCond %{SERVER_PORT} 80
#RewriteCond %{HTTPS} off
#RewriteRule .* https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

#RewriteRule . maintenance.php [L]

RewriteRule ^accueil$ index.php [L]

#authentification
RewriteRule ^page-de-connexion$ login.php [L]
RewriteRule ^jquery-login$ login-user.js [L]
RewriteRule ^page-de-connexion-controller$ loginController.php [L]
RewriteRule ^signout$ auth/logout.php [L]

#autres pages

RewriteRule 401 erreur/401.php
RewriteRule 403 erreur/403.php
RewriteRule 404 erreur/404.php
RewriteRule 429 erreur/429.php
RewriteRule 500 erreur/500.php
RewriteRule 503 erreur/503.php

ErrorDocument 401 /personnel/personnel/erreur/401.php
ErrorDocument 403 /personnel/erreur/403.php
ErrorDocument 404 /personnel/erreur/404.php
ErrorDocument 429 /personnel/erreur/429.php
ErrorDocument 500 /personnel/erreur/500.php
ErrorDocument 503 /personnel/erreur/503.php

RewriteRule ^erreur$ erreur.php [L]
RewriteRule ^erreur-de-connexion$ 100.php [L]
RewriteRule ^maintenance$ maintenance.php [L]
RewriteRule ^signout$ auth/logout.php [L]

RewriteRule ^fichier_introuvable$ fichierIntrouvable.php [L]

RewriteRule ^signout$ auth/logout.php [L]

#rediriger vers la page 404



#ErrorDocument erreur /personnel/erreur



#auth
RewriteRule ^auth-controller$ auth/controllers/authController.php [L]
RewriteRule ^signup$ auth/register.php [L]
RewriteRule ^scripts.bundle.1.js$ auth/js/register.js [L]

RewriteRule ^signin$ auth/login.php [L]
RewriteRule ^scripts.bundle.2.js$ auth/js/login.js [L]

RewriteRule ^activate-account/(.*)/(.*)$ auth/activate.php?mat=$1&code=$2 [L]
RewriteRule ^scripts.bundle.3.js$ auth/js/activate.js [L]

RewriteRule ^reset-password$ auth/reset.php [L]
RewriteRule ^scripts.bundle.4.js$ auth/js/reset.js [L]

RewriteRule ^change-password/(.*)/(.*)$ auth/resetPassword.php?mat=$1&code=$2 [L]
RewriteRule ^scripts.bundle.5.js$ auth/js/resetPassword.js [L]

RewriteRule ^user-modification-mdp/(.*)/(.*)$ auth/userCreerMDP.php?mat=$1&code=$2 [L]
RewriteRule ^scripts.bundle.14.js$ auth/js/userCreerMDP.js [L]


#admin
RewriteRule ^admin-controller$ admin/controllers/adminController.php [L]
RewriteRule ^admin-dashboard$ admin/dashboard.php [L]
RewriteRule ^scripts.bundle.6.js$ auth/js/register.js [L]

RewriteRule ^admin-liste-utilisateurs$ admin/listeUtilisateurs.php [L]
RewriteRule ^scripts.bundle.7.js$ admin/js/listeUtilisateurs.js [L]

RewriteRule ^admin-liste-sous-menus$ admin/sousMenus.php [L]
RewriteRule ^scripts.bundle.8.js$ admin/js/sousMenus.js [L]

RewriteRule ^admin-liste-taches$ admin/listeTaches.php [L]
RewriteRule ^scripts.bundle.9.js$ admin/js/listeTaches.js [L]

RewriteRule ^admin-liste-tache_qualification$ admin/tacheQualification.php [L]
RewriteRule ^scripts.bundle.10.js$ admin/js/tacheQualification.js [L]

RewriteRule ^admin-accueil$ admin/accueil.php [L]
RewriteRule ^scripts.bundle.11.js$ admin/js/accueil.js [L]

RewriteRule ^admin-ordre-d-affichage-menu$ admin/ordreMenu.php [L]
RewriteRule ^scripts.bundle.15.js$ admin/js/ordreMenu.js [L]






# page accueil par defaut des aplications

RewriteRule ^page_par_defaut_basi$ default/default_basi.php [L]
RewriteRule ^page_par_defaut_diplome$ default/default_diplome.php [L]
RewriteRule ^page_par_defaut_finance$ default/default_finance.php [L]
RewriteRule ^page_par_defaut_pedagogie$ default/default_pedagogie.php [L]
RewriteRule ^page_par_defaut_personnel$ default/default_personnel.php [L]
RewriteRule ^page_par_defaut_scolarite$ default/default_scolarite.php [L]
RewriteRule ^page_par_defaut_finance_stats$ default/default_finance_stats.php [L]




#user simple
RewriteRule ^user-controller$ userSimple/controllers/userSimpleController.php [L]


RewriteRule ^user-accueil$ userSimple/accueil.php [L]
RewriteRule ^scripts.bundle.12.js$ userSimple/js/accueil.js [L]

RewriteRule ^user-gestion-taches$ userSimple/gestionTaches.php [L]
RewriteRule ^scripts.bundle.13.js$ userSimple/js/gestionTaches.js [L]



#menus

RewriteRule ^menu-controller$ menus/controllers/menuController.php [L]
RewriteRule ^scripts.bundle.gs.js$ menus/js/menu.js [L]



















